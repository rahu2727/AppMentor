# AppMentor — API Keys Configuration
# =====================================
# Copy this file to .env and fill in your own values
# NEVER commit the .env file to GitHub
# Your .gitignore already excludes it automatically
#
# How to get each key:
# ====================

# REQUIRED — Powers the Claude AI brain
# Get from: console.anthropic.com
# Sign up → Billing → Add $10 credit → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-your-key-here

# REQUIRED — Powers web search tool in Week 1 agent
# Get from: app.tavily.com (free account)
# Free tier: 1,000 searches/month — enough for development
TAVILY_API_KEY=tvly-your-key-here

# OPTIONAL — LangSmith tracing (added in Week 3)
# Get from: smith.langchain.com (free account)
LANGCHAIN_API_KEY=ls__your-key-here
LANGCHAIN_PROJECT=appmenter
